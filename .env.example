# Copier en .env (jamais committé). En production : variables d'environnement du serveur.
RODIUM_API_KEY=
RODIUM_MODEL=anthropic/claude-haiku-5-5

TAVILY_API_KEY=
OPENWEATHER_API_KEY=

NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=          # page de test partagée avec l'intégration

# Google (compte de TEST) : obtenir le refresh token avec scripts/google_login.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=             # agenda de TEST dédié (obligatoire, pas l'agenda principal)
GOOGLE_DRIVE_FOLDER_ID=         # dossier Drive de TEST (obligatoire ; sous-dossiers inclus)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=                  # mot de passe d'application
SMTP_FROM=

APP_TIMEZONE=Europe/Paris
APP_ACCESS_CODE=                # optionnel : protège l'appli
